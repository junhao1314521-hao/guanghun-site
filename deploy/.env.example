# ===== 光魂官网 · 生产环境变量 =====
# 复制为 /opt/website/app/.env 后按实际环境修改；首次部署由 install.sh 自动生成。
# 注意：此文件只放在服务器，不入仓库、不进部署包。

NODE_ENV=production
PORT=3002

# 前端构建产物（本地已构建，服务器不再执行 Vite）
STATIC_DIR=/opt/website/app/gh-web/dist

# 官网自己的 SQLite 与素材目录（不要指向商城 / 其他项目，避免文件串库）
DB_PATH=/opt/website/data/gh.sqlite
UPLOAD_DIR=/opt/website/data/uploads
BACKUP_DIR=/opt/website/data/backups

# 上传大小分档（可选；缺省 图片 10MB / 文档 50MB / 视频 200MB / 安装包 300MB）
# UPLOAD_MAX_SIZE_IMAGE=10mb
# UPLOAD_MAX_SIZE_DOC=50mb
# UPLOAD_MAX_SIZE_VIDEO=200mb
# UPLOAD_MAX_SIZE_INSTALLER=300mb

# 素材库 /uploads 软限流（次/分钟/IP；仅拦批量遍历，正常下载与图片浏览不受影响）
# UPLOAD_RATE_LIMIT_MAX=120

# 防盗链：仅拦截明确的第三方 Referer；空 Referer（直接访问 / 扫码 / 下载器）放行。
# 生产环境默认开启，设 0 可关闭；DOWNLOAD_REFERER_ALLOW 追加可信来源（逗号分隔，填 origin）
# UPLOAD_HOTLINK_GUARD=1
# DOWNLOAD_REFERER_ALLOW=https://cdn.example.com

# 第一阶段：直接用 IP + 端口验收
SITE_ORIGIN=http://8.163.108.144:3002

# 后台种子口令：仅首次建库生效；已有库可在后台右上角「修改密码」轮换（无需清库）
# 强度要求：10–64 位，且同时包含字母与数字
ADMIN_PASSWORD=__ADMIN_PASSWORD__
ADMIN_OPERATOR_PASSWORD=__OPERATOR_PASSWORD__

# 会话有效期（毫秒）：后台默认 8 小时，前台会员默认 7 天；重启服务会清空后台内存会话
# SESSION_TTL_MS=28800000
# USER_SESSION_TTL_MS=604800000

# 找回密码通知通道（预留）：默认 none 不投递；开通短信 / 邮件后填 webhook 即生效，无需改代码
# 阿里云 / 腾讯云短信、企业邮箱均可包一层云函数 / 中转服务暴露成 HTTP 接口
# NOTIFY_CHANNEL=none
# NOTIFY_WEBHOOK_URL=https://your-gateway.example.com/notify
# NOTIFY_WEBHOOK_TOKEN=
# NOTIFY_TIMEOUT_MS=8000

# ===== 切换到 HTTPS 时三项必须一起改，否则会出现「登录后立刻掉线」 =====
# 1) SITE_ORIGIN 改成 https://正式域名
# 2) COOKIE_SECURE=1
# 3) TRUST_PROXY=1（前面有 Nginx / CDN 时必须开，否则限流会按代理 IP 统计）
# HTTP 阶段：COOKIE_SECURE=0；切到 HTTPS 后改为 1
COOKIE_SECURE=0
# 前置 Nginx / CDN 后改为 1
TRUST_PROXY=0

# 后台登录防爆破：单 IP 每分钟上限 / 连续失败锁定阈值 / 锁定时长（毫秒）
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_LOCK_THRESHOLD=10
# LOGIN_LOCK_MS=900000

# 素材库磁盘配额（字节，默认 20GB；0 = 不限制）
# UPLOAD_QUOTA_BYTES=21474836480

# 数据库备份镜像目录（挂载 NAS / 另一块盘时填写，每次快照同步复制一份）
# BACKUP_MIRROR_DIR=/mnt/backup/guanghun

# 旧站直链 301 映射表（默认与数据库同目录的 legacy-redirects.json）
# LEGACY_REDIRECTS_PATH=/opt/website/data/legacy-redirects.json
